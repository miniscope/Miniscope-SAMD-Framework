#include <atmel_start.h>
#include "MS_definitions.h"

int main(void)
{
	#ifdef PYTHON480_ENABLE
	getBuffersPerFrame();
	#endif
	
	/* Initializes MCU, drivers and middleware */
	atmel_start_init();
	
	__disable_irq();
	DataBufferInit(); // For testing buffer to SERCOM DMA

	peripheralInit();

	#ifdef DMA_TO_SD_ENABLE
	debugHeaderProp();
	#endif
	
	dmaEnable();
	
	__enable_irq();

	#ifdef DEV_MODE
	delay_ms(100);
	deviceState = DEVICE_STATE_START_RECORDING;
	#endif
		
	while (1) { // mostly recording_cb and framevalid_cb runs here
		
		#ifdef DMA_TO_SPI_GS_TESTMODE
		if (DMAC->Channel[SDO_DMA_CHANNEL].CHCTRLA.bit.ENABLE == 0)
		{
			_dma_enable_transaction(SDO_DMA_CHANNEL, false);
			writeBufferCount++; // not sure if this should be counted
			return;
		}
		sdo_dma_transfer_resume();
		#endif
		
		#if defined(PYTHON480_ENABLE)
		
		if (deviceState & DEVICE_STATE_START_RECORDING) {
			startRecording();
		}
		#endif
		
		#ifndef DEV_MODE
		#ifdef PYTHON480_ENABLE
		if (deviceState & DEVICE_STATE_STOP_RECORDING) {
			stopRecording();
		}
		#endif
		#endif
	}
}